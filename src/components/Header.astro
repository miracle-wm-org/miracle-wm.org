---

---

<header class="site-header">
    <div class="site-header-inner">
        <a class="miracle-wm-logo" href="/">
            <img src="/assets/clearStars.svg" alt="miracle-wm mascot" />
            miracle-wm
        </a>

        <button
            class="hamburger"
            id="hamburger"
            aria-label="Toggle menu"
            aria-expanded="false">&#9776;</button
        >

        <ul class="site-nav" id="nav-menu">
            <li>
                <a
                    href="https://wiki.miracle-wm.org/latest/"
                    rel="noopener noreferrer">Wiki</a
                >
            </li>
            <li><a href="/plugins">Plugins</a></li>
            <li>
                <a
                    href="https://docs.miracle-wm.org/miracle_plugin/"
                    rel="noopener noreferrer">Plugin API</a
                >
            </li>
            <li>
                <a
                    href="https://trello.com/b/ldzWTZDK/miracle"
                    target="_blank"
                    rel="noopener noreferrer">Roadmap <i class="fa-solid fa-arrow-up-right-from-square"></i></a
                >
            </li>
            <li>
                <a
                    href="https://github.com/miracle-wm-org/miracle-wm"
                    target="_blank"
                    rel="noopener noreferrer">GitHub <i class="fa-solid fa-arrow-up-right-from-square"></i></a
                >
            </li>
            <li>
                <button
                    id="theme-toggle"
                    class="theme-toggle"
                    aria-label="Toggle theme"
                >
                    <i id="theme-icon-dark" class="fa-solid fa-sun"></i>
                    <i id="theme-icon-light" class="fa-solid fa-moon"></i>
                </button>
            </li>
        </ul>
    </div>
</header>

<script>
    const hamburger = document.getElementById("hamburger")!;
    const navMenu = document.getElementById("nav-menu")!;

    hamburger.addEventListener("click", () => {
        const isOpen = navMenu.classList.toggle("open");
        hamburger.setAttribute("aria-expanded", String(isOpen));
    });
</script>
