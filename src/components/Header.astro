---

<header>
    <a class="miracle-wm-logo" href="/">
        <img
            src="https://raw.githubusercontent.com/miracle-wm-org/miracle-wm/refs/heads/develop/icons/clearStars/clearStars.svg"
            alt="miracle-wm mascot"
        />
        miracle
    </a>

    <ul class="miracle-wm-header-list">
        <li>
            <a href="https://wiki.miracle-wm.org/latest/">Wiki</a>
        </li>
        <li>
            <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
                <span class="theme-toggle-icon">🌓</span>
            </button>
        </li>
        <li>
            <a href="https://github.com/miracle-wm-org/miracle-wm">
                <svg width="16" height="16" class="github-icon">
                    <image
                        class="github-icon-dark"
                        xlink:href="/assets/github-mark-c791e9551fe4/github-mark/github-mark-white.svg"
                        src="/assets/github-mark-c791e9551fe4/github-mark/github-mark-white.png"
                        width="16"
                        height="16"
                    />
                    <image
                        class="github-icon-light"
                        xlink:href="/assets/github-mark-c791e9551fe4/github-mark/github-mark.svg"
                        src="/assets/github-mark-c791e9551fe4/github-mark/github-mark.png"
                        width="16"
                        height="16"
                    />
                </svg>
            </a>
        </li>
    </ul>
</header>
