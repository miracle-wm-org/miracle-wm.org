---
---

<section class="hero">
    <div class="hero-content">
        <div class="hero-text">
            <h1 class="hero-title">
                <span class="hero-miracle">miracle</span><span class="hero-wm">-wm</span>
            </h1>
            <p class="hero-subtitle">
                A flashy tiling Wayland window manager built on top of <a href="https://github.com/canonical/mir">Mir</a>
            </p>
            <div class="hero-actions">
                <a href="https://github.com/miracle-wm-org/miracle-wm" class="btn btn-primary">
                    <svg width="16" height="16" class="github-icon">
                        <image
                            class="github-icon-dark"
                            xlink:href="/assets/github-mark-c791e9551fe4/github-mark/github-mark-white.svg"
                            src="/assets/github-mark-c791e9551fe4/github-mark/github-mark-white.png"
                            width="16"
                            height="16"
                        />
                        <image
                            class="github-icon-light"
                            xlink:href="/assets/github-mark-c791e9551fe4/github-mark/github-mark.svg"
                            src="/assets/github-mark-c791e9551fe4/github-mark/github-mark.png"
                            width="16"
                            height="16"
                        />
                    </svg>
                    View on GitHub
                </a>
                <a href="https://wiki.miracle-wm.org/latest/" class="btn btn-secondary">
                    📖 Documentation
                </a>
            </div>
        </div>
        <div class="hero-mascot">
            <img
                src="https://raw.githubusercontent.com/miracle-wm-org/miracle-wm/refs/heads/develop/icons/clearStars/clearStars.svg"
                alt="miracle-wm mascot"
                class="mascot-image"
            />
        </div>
    </div>
</section>
